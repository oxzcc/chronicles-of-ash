# Скопируй в .env и заполни. .env никогда не коммитится.

# База и очередь (docker compose up -d postgres redis)
DATABASE_URL="postgresql://ash:ash@localhost:5432/ash"
REDIS_URL="redis://localhost:6379"

# Модели текста — через OpenRouter (один ключ на все модели)
OPENROUTER_API_KEY=""
# Модели по ролям (id в OpenRouter). Меняются без правки кода.
# Пока обе модели — DeepSeek: Sonnet заметно дороже, а разница в качестве не подтверждена.
# Вернуть Sonnet для платного тарифа: NARRATOR_MODEL_PAID="anthropic/claude-sonnet-5.5"
NARRATOR_MODEL_PAID="deepseek/deepseek-v4.1-flash"
NARRATOR_MODEL_FREE="deepseek/deepseek-v4.1-flash"
UTILITY_MODEL="deepseek/deepseek-v4.1-flash"
# Модель со зрением проверяет готовые портреты: лишние руки и слишком крупный кадр → перерисовка.
# Пусто — проверки нет. Haiku 5.5: ~$0.00013 и ~1.5 с на портрет, третью руку находит (Gemini — в 18 раз дороже).
VISION_MODEL="anthropic/claude-haiku-5.5"

# Сколько модель «думает» перед ответом: minimal | low | medium | high.
# low — быстрее и дешевле; без этого Sonnet тратит большую часть токенов на скрытые рассуждения.
LLM_REASONING_EFFORT="low"

# Картинки — FLUX через fal.ai
FAL_KEY=""
FAL_PORTRAIT_MODEL="fal-ai/flux-2/klein/4b"
FAL_BACKGROUND_MODEL="fal-ai/flux-2/klein/4b"
# Вырезание фона у портретов
FAL_CUTOUT_MODEL="fal-ai/birefnet/v2"
# LoRA стиля мира (pnpm lora:train пишет URL весов). Пока URL пуст, мир рисуется по текстовому стилю.
# Сила 0…2: меньше — ближе к обычному FLUX, больше — сильнее стиль датасета.
FAL_LORA_ARKHAM_URL=""
FAL_LORA_ARKHAM_SCALE="1.2"
# LoRA обучаются на klein 9B Base (тренер 4B на fal закрыт) и рисуются той же Base-моделью — около $0.02 за портрет.
# Дистиллированная klein/9b/lora такую LoRA почти не применяет.
FAL_LORA_MODEL="fal-ai/flux-2/klein/9b/base/lora"
# Эмоции портретов — правка готового портрета той же моделью, на которой обучена LoRA (по умолчанию — так).
# FAL_EDIT_MODEL="fal-ai/flux-2/klein/9b/base/edit/lora"
# Без FAL_KEY или с IMAGES_FAKE=1 — фейковые картинки (градиенты и силуэты)
IMAGES_FAKE="0"
# Сколько картинок рисуется одновременно
IMAGES_CONCURRENCY="4"

# Если ключа OpenRouter нет, игра ходит в фейковую модель (для разработки интерфейса)
LLM_FAKE="0"
